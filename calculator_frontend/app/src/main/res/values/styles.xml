<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- PUBLIC_INTERFACE
         Style for calculator numeric buttons to ensure consistent sizing, rounded corners,
         and subtle elevation for Ocean Professional theme.
    -->
    <style name="CalcNumButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:backgroundTint">#FFFFFF</item>
        <item name="android:textColor">#111827</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">18sp</item>
        <item name="android:elevation">4dp</item>
    </style>
</resources>
